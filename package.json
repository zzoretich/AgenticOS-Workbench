{
  "name": "agenticos-workbench",
  "private": true,
  "version": "0.17.0",
  "description": "AgenticOS Workbench: a second brain for Claude Code with an Obsidian HUD",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "brain/scripts",
    "obsidian-plugin"
  ],
  "scripts": {
    "test": "node --require ./tools/test-env.js --test tools/*.test.js cli/*.test.js && npm test --workspaces --if-present",
    "gate": "node tools/privacy-gate.js",
    "export": "node tools/export-from-vault.js",
    "setup": "node cli/aos.js init",
    "version:bump": "node tools/bump-version.js",
    "build:codex-plugin": "node tools/build-codex-plugin.js",
    "lint": "eslint .",
    "lint:sh": "node tools/lint-shell.js",
    "typecheck": "npm run typecheck -w obsidian-plugin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  }
}
