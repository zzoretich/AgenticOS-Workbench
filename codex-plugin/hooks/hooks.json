{
  "description": "AgenticOS Workbench for Codex: brain context injection, conventions, session capture, telemetry, and dashboard refresh. Every command runs bin/aos with AOS_HOST=codex; bin/aos exits 0 when the workbench has not been initialized, so a hook never fails a session. Generated by tools/build-codex-plugin.js from cli/codex-host.js HOOKS.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" telemetry-hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" update-notice",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" persona-watchdog",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" reconcile-sessions",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" inject-conventions",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" inject-context",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" telemetry-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" update-session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" heartbeat-writer",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" reconcile-sessions",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" telemetry-hook",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" auto-cost",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" heartbeat-writer",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" auto-wrap",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "env AOS_HOST=codex sh \"${PLUGIN_ROOT}/bin/aos\" scan-vault --quiet",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
