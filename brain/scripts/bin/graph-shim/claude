#!/bin/sh
# `claude` for graphify's claude-cli backend during the vault graph's semantic pass (spec 2026-09-23-graphify D6).
# graph-build.js puts this directory first on graphify's PATH and sets AOS_NODE; graph-claude.js does the work.
exec "${AOS_NODE:-node}" "$(dirname "$0")/../../graph-claude.js" "$@"
