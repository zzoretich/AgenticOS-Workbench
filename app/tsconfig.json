{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "obsidian": [
        "compat/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "compat/src/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/screens/**/*.ts",
    "playwright.screens.config.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "../obsidian-plugin/**/*.test.ts"
  ]
}
