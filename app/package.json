{
  "name": "agenticos-workbench-app",
  "productName": "UniDeX",
  "private": true,
  "version": "1.7.0",
  "description": "AgenticOS Workbench as a macOS app: the Workbench HUD re-hosted on an Obsidian compatibility layer",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/fix-pty.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "check:compat": "node scripts/check-compat.mjs",
    "screens": "node scripts/build.mjs && AOS_E2E_FIXTURE=${AOS_E2E_FIXTURE:-/tmp/agenticos-demo} playwright test -c playwright.screens.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "test:unit": "node scripts/test-unit.mjs",
    "fixture": "node scripts/make-fixture-vault.mjs",
    "payload": "node scripts/make-payload.mjs",
    "dist": "node scripts/make-payload.mjs && node scripts/build.mjs && electron-builder --mac --arm64 --publish never",
    "dist:test": "node scripts/make-payload.mjs && AOS_APP_TEST_BUILD=1 node scripts/build.mjs && electron-builder --mac --arm64 --dir --publish never -c.directories.output=dist-test -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:verify": "node scripts/verify-dist.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "release:app": "node scripts/release-app.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "lucide": "^1.48.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.63.0",
    "typescript": "~5.9",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": false
  }
}
