{
  "name": "agenticos-workbench-app",
  "productName": "AgenticOS Workbench",
  "private": true,
  "version": "0.21.0",
  "description": "AgenticOS Workbench as a macOS app: the Workbench HUD re-hosted on an Obsidian compatibility layer",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/fix-pty.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "check:compat": "node scripts/check-compat.mjs",
    "spike:screens": "node scripts/build.mjs && node scripts/spike-screens.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "test:unit": "node scripts/test-unit.mjs",
    "fixture": "node scripts/make-fixture-vault.mjs",
    "dist": "node scripts/build.mjs && electron-builder --mac --arm64 --publish never",
    "dist:verify": "node scripts/verify-dist.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.48.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.63.0",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": false
  }
}
